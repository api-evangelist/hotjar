          "name": "Look up or delete user data",
          "request": {
            "name": "Look up or delete user data",
            "description": {
              "content": "Looks up user data across sites in an organization and optionally deletes all associated data. This endpoint supports GDPR compliance by enabling automated user data lookup and deletion requests. At least one of data_subject_email or data_subject_site_id_to_user_id_map must be provided. Available on Observe and Ask Scale plans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "organizations",
                ":organization_id",
                "user-lookup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "organization_id",
                  "description": "(Required) The unique identifier for the organization."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
