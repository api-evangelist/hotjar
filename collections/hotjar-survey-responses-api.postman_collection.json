      "id": "0362b969-6268-4a15-97b1-5747b28d9fd3",
      "name": "Survey Responses",
      "description": {
        "content": "Endpoints for exporting and listing survey response data with cursor-based pagination.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6461479a-9909-464a-9a7a-73ea4ff2b40c",
          "name": "List survey responses",
          "request": {
            "name": "List survey responses",
            "description": {
              "content": "Returns a paginated list of responses for a specific survey. Responses are sorted by creation date in descending order, with the most recent responses returned first. Supports cursor-based pagination with a maximum of 100 responses per page. Available on Ask Scale plans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sites",
                ":site_id",
                "surveys",
                ":survey_id",
                "responses"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The number of items to return per page. Maximum value is 100."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "The cursor value for fetching the next page of results. Obtained from the next_cursor field in a previous response."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "site_id",
                  "description": "(Required) The unique identifier for the site. Can be found in the Sites and Organizations page under the respective organization."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "survey_id",
                  "description": "(Required) The unique identifier for the survey."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
